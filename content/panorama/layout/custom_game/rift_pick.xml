<root>
  <styles><include src="file://{resources}/styles/custom_game/rift_pick.css" /></styles>
  <scripts><include src="file://{resources}/scripts/custom_game/rift_ui_model.js" /><include src="file://{resources}/scripts/custom_game/rift_pick.js" /></scripts>
  <Panel class="PickRoot" hittest="true">
    <Panel class="PickScreen" id="PickScreen">
      <Panel class="PickHeader"><Panel class="PickBrand"><Label class="PickKicker" text="#rift_pick_kicker" /><Label class="PickWordmark" text="DUALITY" /></Panel><Panel class="PickHeaderCenter"><Label class="PickHeaderTitle" text="#rift_pick_roster" /><Label class="PickHeaderHint" text="#rift_pick_header_hint" /></Panel><Panel class="PickClock"><Label text="#rift_pick_time" /><Label id="PickTimer" text="40" /></Panel></Panel>
      <Panel id="PickPlayers" class="PickPlayers" />
      <Panel class="PickBody">
        <Panel class="PickRoster"><Label class="PickSection" text="#rift_pick_roster" /><Label class="PickHelp" text="#rift_pick_help" /><Panel id="PickHeroes" class="PickHeroes" /><Label class="PickFooter" text="#rift_pick_path_hint" /></Panel>
        <Panel id="PickDetails" class="PickDetails">
          <Panel class="PickShowcase"><Panel class="PickPortraitHalo" /><DOTAHeroMovie id="PickPortrait" class="PickPortrait" hittest="false" /><Panel class="PickHeroIntro"><Label class="PickEyebrow" text="#rift_pick_selected_hero" /><Label id="PickHeroName" class="PickHeroName" /><Label class="PickHeroCaption" text="#rift_pick_hero_caption" /></Panel></Panel>
          <Panel class="PickPaths"><Button id="PickPhysical" class="PickPath" onactivate="RiftPickPath('physical')"><Label text="#rift_dir_physical" /></Button><Button id="PickMagical" class="PickPath" onactivate="RiftPickPath('magical')"><Label text="#rift_dir_magical" /></Button></Panel>
          <Panel id="PickAbilities" class="PickAbilities" />
          <Label id="PickPathName" class="PickPathName" />
          <Panel class="PickDescriptionScroll"><Label id="PickDescription" class="PickDescription" /></Panel>
          <Label id="PickStatus" class="PickStatus" />
          <Button id="PickConfirm" class="PickConfirm" onactivate="RiftPickConfirm()"><Label id="PickConfirmLabel" text="#rift_pick_confirm" /></Button>
        </Panel>
      </Panel>
    </Panel>
  </Panel>
</root>
